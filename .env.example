# Opcional: link CSV da planilha publicada com os dados de atuação (mapa da home).
# Colunas: uf, municipio, setor, icone, projetos. Ver src/data/usePresenca.js.
VITE_PRESENCA_CSV=

# EmailJS (formulário de contato). Pegue os valores no painel do EmailJS.
# A chave pública vai para o navegador por design; a proteção real fica no painel
# (domínios permitidos e limite de envios). Nunca coloque aqui a chave privada.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
